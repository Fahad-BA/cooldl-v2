[Unit]
Description=CoolDL Bot Service
After=network.target

[Service]
Type=forking
User=fahad
WorkingDirectory=/home/fahad/cooldl
Environment=PATH=/home/fahad/cooldl/venv/bin
ExecStart=/home/fahad/cooldl/start_bot.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
TimeoutStartSec=30

[Install]
WantedBy=default.target